---
import { Box, Flex, Separator, Text } from "@radix-ui/themes";
import TaskItem from "./TaskItem.astro";
import type { ReleaseTask } from "@/types/ReleaseTask";

interface Props {
    tasks: ReleaseTask[];
    clientName: string;
}

const { tasks, clientName } = Astro.props;
---

<Box
    style={{ padding: "0.5rem 1rem", backgroundColor: "var(--gray-2)" }}
    className="task-list"
>
    <Flex direction="column" gap="4">
        {
            tasks
                .sort(
                    (a, b) =>
                        new Date(a.startDate).getTime() -
                        new Date(b.startDate).getTime(),
                )
                .map((task) => <TaskItem clientName={clientName} task={task} />)
        }
    </Flex>
</Box>
