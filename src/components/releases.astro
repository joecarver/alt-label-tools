---
import { getReleases } from "@/utils/NotionApi";
import { Card, Text, Box, Flex, Badge } from "@radix-ui/themes";
import { ReleaseTaskName } from "@/types/ReleaseTask";
import { ReleaseTaskStatus } from "@/types/ReleaseTaskStatus";

const clientId = Astro.props.clientId;

const releases = await getReleases(clientId);

const isDetectableTask = (taskName: string) => {
    console.log(taskName);
    return [
        ReleaseTaskName.ContractCreated,
        ReleaseTaskName.PreMastersSubmitted,
        ReleaseTaskName.MastersSubmitted,
        ReleaseTaskName.ArtworkCreation,
    ].includes(taskName as ReleaseTaskName);
};

const getStatusColor = (status: ReleaseTaskStatus) => {
    switch (status) {
        case ReleaseTaskStatus.TODO:
            return "gray";
        case ReleaseTaskStatus.IN_PROGRESS:
            return "blue";
        case ReleaseTaskStatus.DONE:
            return "green";
        default:
            return "gray";
    }
};
---

<Flex
    as="ul"
    css={{ listStyle: "none", padding: 0 }}
    direction="column"
    gap="2"
>
    {
        releases.map((release) => (
            <Card as="li" key={release.id} direction="column">
                <Text as="span" weight="bold">
                    {release.catalogNumber} - {release.artist}
                </Text>
                <Flex
                    as="ul"
                    direction="column"
                    gap="2"
                    size="2"
                    css={{ listStyle: "none", padding: 0 }}
                >
                    {release.tasks
                        .sort(
                            (a, b) =>
                                new Date(a.startDate).getTime() -
                                new Date(b.startDate).getTime(),
                        )
                        .map((task) => (
                            <Flex as="li" key={task.id} direction="column">
                                <Flex gap="2" align="center">
                                    <Text as="span" key={task.id}>
                                        {task.name}
                                    </Text>
                                    {isDetectableTask(task.name) && (
                                        <Badge
                                            color={getStatusColor(task.status)}
                                        >
                                            {task.status}
                                        </Badge>
                                    )}
                                </Flex>
                                <Text as="span" size="2" color="gray">
                                    {task.startDate} - {task.endDate}
                                </Text>
                            </Flex>
                        ))}
                </Flex>
            </Card>
        ))
    }
</Flex>
