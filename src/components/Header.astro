---
import { Text } from "@radix-ui/themes";
import { getAuthTokenFromCookies } from "@/utils/auth";
import { verifyToken } from "@/utils/auth";
import Avatar from "./Avatar.astro";

// Get user info
const token = getAuthTokenFromCookies(Astro.cookies);
let userInfo = null;
if (token) {
    userInfo = await verifyToken(token);
}
---

<header>
    <Text as="div" className="header-title">ALT ~ Automated Label Tools</Text>
    {userInfo && <Avatar userInfo={userInfo} />}
</header>

<style>
    header {
        height: var(--header-height);
        background: white;
        box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
        padding: 0.5rem 1rem;
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        /* align-items: space-between; */
        /* justify-content: space-between; */
    }

    .header-content {
        margin: 0 auto;
        padding: 0 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-title {
        font-size: clamp(1rem, 2.5vw, 1.5rem);
        font-weight: 600;
        color: rgb(var(--gray-900));
        margin: 0;
    }
</style>
