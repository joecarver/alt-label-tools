---
import { Card, Text, Flex, Badge } from "@radix-ui/themes";
import TaskList from "./TaskList.astro";
import { ReleaseTaskName, type ReleaseTask } from "@/types/ReleaseTask";
import { CompletionStatus } from "@/types/CompletionStatus";
import type { Release } from "@/types/Release";
import { formatSingleDate } from "@/utils/date";
import { BadgeColor } from "@/types/BadgeColor";

interface Props {
    release: Release;
    clientName: string;
}

const { release, clientName } = Astro.props;

const getReleaseSummary = (tasks: ReleaseTask[]) => {
    const totalTasks = tasks.length;
    const completedTasks = tasks.filter(
        (task) =>
            task.status === CompletionStatus.DONE_DETECTED ||
            task.status === CompletionStatus.DONE_MANUALLY,
    ).length;

    return {
        totalTasks,
        completedTasks,
        color:
            completedTasks === totalTasks
                ? BadgeColor.GREEN
                : completedTasks > totalTasks / 2
                  ? BadgeColor.YELLOW
                  : completedTasks > 0
                    ? BadgeColor.ORANGE
                    : BadgeColor.RED,
    };
};

const summary = getReleaseSummary(release.tasks);
---

<Card size="2">
    <Flex direction="column" gap="3">
        <Flex justify="between" align="center">
            <Flex direction="column" gap="1">
                <Text size="4" weight="bold">
                    {release.name}
                </Text>
                <Badge size="2" color="blue" variant="soft">
                    Release Date: {formatSingleDate(release.releaseDate)}
                </Badge>
            </Flex>
        </Flex>

        <details>
            <summary>
                <Badge size="2" color={summary.color} variant="soft">
                    {summary.completedTasks} / {summary.totalTasks} tasks completed
                </Badge>
            </summary>
            <TaskList clientName={clientName} tasks={release.tasks} />
        </details>
    </Flex>
</Card>
