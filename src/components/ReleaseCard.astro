---
import { Card, Text, Flex, Badge } from "@radix-ui/themes";
import TaskList from "./TaskList.astro";
import { ReleaseTaskName, type ReleaseTask } from "@/types/ReleaseTask";
import { CompletionStatus } from "@/types/CompletionStatus";
import type { Release } from "@/types/Release";
import { formatSingleDate } from "@/utils/date";

interface Props {
    release: Release;
    clientName: string;
}

const { release, clientName } = Astro.props;

const getReleaseSummary = (tasks: ReleaseTask[]) => {
    const detectableTasks = tasks.filter((task) =>
        [
            ReleaseTaskName.ContractCreated,
            ReleaseTaskName.PreMastersSubmitted,
            ReleaseTaskName.MastersSubmitted,
            ReleaseTaskName.ArtworkCreation,
        ].includes(task.name),
    );
    const totalTasks = detectableTasks.length;
    const completedTasks = detectableTasks.filter(
        (task) => task.status === CompletionStatus.DONE,
    ).length;
    const inProgressTasks = detectableTasks.filter(
        (task) => task.status === CompletionStatus.IN_PROGRESS,
    ).length;

    if (completedTasks === totalTasks) {
        return { status: "Complete", color: "green" as const };
    } else if (inProgressTasks > 0 || completedTasks > 0) {
        return { status: "In Progress", color: "blue" as const };
    }
    return { status: "Not Started", color: "gray" as const };
};

const summary = getReleaseSummary(release.tasks);
---

<Card size="2">
    <Flex direction="column" gap="3">
        <Flex justify="between" align="center">
            <Flex direction="column" gap="1">
                <Text size="4" weight="bold">
                    {release.name}
                </Text>
                <Badge size="2" color="blue" variant="soft">
                    Release Date: {formatSingleDate(release.releaseDate)}
                </Badge>
            </Flex>
            <Badge size="2" color={summary.color} variant="soft">
                {summary.status}
            </Badge>
        </Flex>

        <details>
            <summary>
                <Text size="2" color="gray">
                    View Tasks ({release.tasks.length})
                </Text>
            </summary>
            <TaskList clientName={clientName} tasks={release.tasks} />
        </details>
    </Flex>
</Card>
