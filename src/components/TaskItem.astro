---
import { Text, Flex, Badge, Box } from "@radix-ui/themes";
import { ReleaseTaskName, type ReleaseTask } from "@/types/ReleaseTask";
import { ReleaseTaskStatus } from "@/types/ReleaseTaskStatus";
import { parseISO } from "date-fns";
import { formatDateRange } from "@/utils/date";
import { checkFileExists } from "@/utils/drive";
import { getAuthTokenFromCookies } from "@/utils/auth";

interface Props {
    task: ReleaseTask;
}

type BadgeColor = "gray" | "blue" | "green" | "red" | "orange";

const { task } = Astro.props;

const isDetectableTask = (taskName: string) => {
    return [
        ReleaseTaskName.ContractCreated,
        ReleaseTaskName.PreMastersSubmitted,
        ReleaseTaskName.MastersSubmitted,
        ReleaseTaskName.ArtworkCreation,
    ].includes(taskName as ReleaseTaskName);
};

const getStatusColor = (status: ReleaseTaskStatus): BadgeColor => {
    switch (status) {
        case ReleaseTaskStatus.TODO:
            return "gray";
        case ReleaseTaskStatus.IN_PROGRESS:
            return "blue";
        case ReleaseTaskStatus.DONE:
            return "green";
        default:
            return "gray";
    }
};

const getTaskStatus = async (task: ReleaseTask) => {
    if (!isDetectableTask(task.name)) {
        return null;
    }

    const authToken = getAuthTokenFromCookies(Astro.cookies);
    if (!authToken) {
        return { status: "Not authenticated", color: "gray" as BadgeColor };
    }

    if (task.name === ReleaseTaskName.ContractCreated) {
        const contractFileExists = await checkFileExists(
            "1h8fPUpJ2LUM8KO5GCARzt_DD6CK050VX",
            "contract",
            authToken,
        );

        if (contractFileExists) {
            return { status: "Complete", color: "green" as BadgeColor };
        }
    }

    return { status: task.status, color: getStatusColor(task.status) };
};

const getDueDateStatus = (endDate: string) => {
    const today = new Date();
    const dueDate = parseISO(endDate);
    const daysUntilDue = Math.ceil(
        (dueDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24),
    );

    if (daysUntilDue < 0) {
        return { status: "overdue", color: "red" as BadgeColor };
    } else if (daysUntilDue <= 3) {
        return { status: "due soon", color: "orange" as BadgeColor };
    }
    return null;
};
const dueDateStatus = getDueDateStatus(task.endDate);

const taskStatus = await getTaskStatus(task);
---

<Box>
    <Flex direction="column" gap="1">
        <Flex gap="2" align="center">
            <Text weight="medium">{task.name}</Text>
            {
                isDetectableTask(task.name) && (
                    <Badge size="1" color={taskStatus?.color} variant="soft">
                        {taskStatus?.status}
                    </Badge>
                )
            }
            {
                dueDateStatus && (
                    <Badge size="1" color={dueDateStatus.color} variant="soft">
                        {dueDateStatus.status}
                    </Badge>
                )
            }
        </Flex>
        <Text size="1" color="gray">
            {formatDateRange(task.startDate, task.endDate)}
        </Text>
    </Flex>
</Box>
