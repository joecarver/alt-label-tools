---
import { Text, Flex, Badge, Box, Link } from "@radix-ui/themes";
import { type ReleaseTask } from "@/types/ReleaseTask";
import { CompletionStatus } from "@/types/CompletionStatus";
import { formatDateRange } from "@/utils/date";
import { ClockIcon, OpenInNewWindowIcon } from "@radix-ui/react-icons";
import TaskItemCompletionStatus from "./TaskItemCompletionStatus.astro";
import { getDueDateStatusColor } from "@/utils/getStatusColor";
interface Props {
    clientName: string;
    task: ReleaseTask;
}

const { task } = Astro.props;
---

<Box>
    <Flex direction="column" gap="1">
        <Flex gap="2" align="center" justify="between">
            <Text weight="medium">{task.name}</Text>
        </Flex>
        <Flex gap="1">
            <Badge
                size="2"
                color={getDueDateStatusColor(task.dueDateStatus || undefined)}
                variant="soft"
            >
                <ClockIcon />Due: {
                    formatDateRange(task.startDate, task.endDate)
                }
            </Badge>
            <TaskItemCompletionStatus
                task={task}
                isDetectable={task.isDetectable}
                taskStatus={task.taskStatus}
            />
            {
                task.taskStatus?.status === CompletionStatus.DONE_DETECTED &&
                    task.taskStatus?.fileInfo?.webViewLink && (
                        <Badge size="1" variant="soft">
                            <Link
                                href={task.taskStatus.fileInfo?.webViewLink}
                                target="_blank"
                            >
                                <OpenInNewWindowIcon />
                                <Text>{task.taskStatus.fileInfo?.name}</Text>
                            </Link>
                        </Badge>
                    )
            }
        </Flex>
    </Flex>
</Box>
