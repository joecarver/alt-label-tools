---
import Layout from "../layouts/Layout.astro";
import { getClients } from "@/utils/NotionApi";
import {
	Card,
	Text,
	Grid,
	Container,
	Heading,
	Flex,
	Box,
} from "@radix-ui/themes";
import Releases from "@/components/releases.astro";
import { getAuthTokenFromCookies } from "@/utils/auth";
import { verifyToken } from "@/utils/auth";
import LinkButton from "@/components/LinkButton.astro";
import { PiFolderFill } from "react-icons/pi";
import ClientCard from "@/components/ClientCard.astro";

// Check if user is authenticated
const token = getAuthTokenFromCookies(Astro.cookies);
if (!token) {
	return Astro.redirect("/login");
}

try {
	const payload = await verifyToken(token);
	if (!payload) {
		return Astro.redirect("/login");
	}
} catch (error) {
	console.error("Token verification failed:", error);
	return Astro.redirect("/login");
}

const clients = await getClients(token);
---

<Layout title="Schedule & Workflow Dashboard">
	<Container size="3">
		<Grid columns="1" gap="6">
			<Box>
				<Flex justify="between" align="center" mb="4">
					<Heading size="5">Clients</Heading>
					<Text size="2" color="gray"
						>{clients.length} active clients</Text
					>
				</Flex>
				<Grid columns="1" gap="4">
					{clients.map((client) => <ClientCard client={client} />)}
				</Grid>
			</Box>
		</Grid>
	</Container>
</Layout>
