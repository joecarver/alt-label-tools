---
import Layout from "../layouts/Layout.astro";
import { getClients } from "@/utils/NotionApi";
import { Card, Text, Grid, Container, Heading, Flex } from "@radix-ui/themes";
import Releases from "@/components/releases.astro";
const clients = await getClients();
---

<Layout title="Schedule & Workflow Dashboard">
	<Container size="2">
		<Grid columns="1" gap="4">
			<div>
				<Heading mb="4">Clients</Heading>
				<Grid columns="1" gap="4">
					{
						clients.map((client) => (
							<Card key={client.id}>
								<Flex align="baseline" gap="2">
									<Text as="span" weight="bold">
										{client.name}
									</Text>
									<Text as="span" size="2" color="gray">
										{client.id}
									</Text>
								</Flex>
								<Releases clientId={client.id} />
							</Card>
						))
					}
				</Grid>
			</div>
		</Grid>
	</Container>
</Layout>
