---
import { getAuthTokenFromCookies } from "@/utils/auth";
import { verifyToken } from "@/utils/auth";
import {
    Box,
    Button,
    Flex,
    Heading,
    Link,
    Text,
    Theme,
} from "@radix-ui/themes";
import "@radix-ui/themes/styles.css";
import { BsGoogle } from "react-icons/bs";
import { FaGoogle } from "react-icons/fa";

// Check if user is already authenticated
const token = getAuthTokenFromCookies(Astro.cookies);
if (token) {
    try {
        const payload = await verifyToken(token);
        if (payload) {
            return Astro.redirect("/");
        }
    } catch (error) {
        console.error("Token verification failed:", error);
    }
}

// Get the auth URL server-side
const response = await fetch(`${Astro.url.origin}/api/auth`);
const { authUrl } = await response.json();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Login - Alt Label Tools</title>
    </head>
    <body>
        <Theme>
            <Box className="login-container">
                <Flex direction="column" gap="4" className="login-card">
                    <Heading as="h1" size="9"> ALT </Heading>
                    <Heading as="h2" size="4"> Automated Label Tools </Heading>

                    <Link href={authUrl}>
                        <Button
                            type="button"
                            color="blue"
                            variant="surface"
                            size="4"
                            style={{
                                cursor: "pointer",
                            }}
                        >
                            <FaGoogle /> Sign in with Google
                        </Button>
                    </Link>
                </Flex>
            </Box>
        </Theme>
    </body>

    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: #f9fafb;
        }

        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            max-width: 28rem;
            width: 100%;
            padding: 2rem;
            background-color: rgb(248, 248, 248);
            border-radius: 0.5rem;
            box-shadow:
                0 4px 6px -1px rgb(0 0 0 / 0.1),
                0 2px 4px -2px rgb(0 0 0 / 0.1);
        }

        .login-header {
            text-align: center;
        }

        .login-button {
            width: 100%;
        }
    </style>
</html>
