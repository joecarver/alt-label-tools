---
import ReleaseDetails from "@/components/ReleaseDetails.astro";
import Layout from "@/layouts/Layout.astro";
import type { Release } from "@/types/Release";

const { id } = Astro.params;
const { clients, releases } = Astro.locals;

if (!id) {
  return Astro.redirect("/");
}

let release: Release | undefined = clients
  .flatMap((client) => client.releases)
  .find((release) => release.id === id);

const client = clients.find((client) =>
  client.releases.some((release) => release.id === id)
);

if (!release) {
  release = releases.find((release) => release.id === id);
}

if (!release) {
  return Astro.redirect("/");
}
---

<Layout title={release.name}>
  <ReleaseDetails release={release} />
</Layout>
