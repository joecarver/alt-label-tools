---
import Layout from "../../layouts/Layout.astro";
import { getAuthTokenFromCookies } from "../../utils/auth";
import { verifyToken } from "../../utils/auth";
import { getClients, getReleases } from "../../utils/supabase";
import {
    Card,
    Flex,
    Text,
    Box,
    Grid,
    Container,
    Button,
    Link,
} from "@radix-ui/themes";
import LinkButton from "../../components/LinkButton.astro";
import ReleaseList from "../../components/ReleaseList.astro";
import LoadingSpinner from "../../components/LoadingSpinner.astro";
import { BiArrowBack } from "react-icons/bi";
import type { LabelClient } from "../../types/LabelClient";

// Check if user is authenticated
const token = getAuthTokenFromCookies(Astro.cookies);
if (!token) {
    return Astro.redirect("/login");
}

try {
    const payload = await verifyToken(token);
    if (!payload) {
        return Astro.redirect("/login");
    }
} catch (error) {
    console.error("Token verification failed:", error);
    return Astro.redirect("/login");
}

const { id } = Astro.params;
const clients = await getClients();
const client = clients.find((c: LabelClient) => c.id === id);

if (!client) {
    return Astro.redirect("/");
}

const releases = await getReleases(client.id);
---

<Layout title={`${client.name} - ALT Label Tools`}>
    <Container size="3">
        <Grid columns="1" gap="6">
            <Box>
                <Card size="2">
                    <Flex direction="column" gap="3">
                        <Flex justify="between" align="center">
                            <Flex direction="row" gap="2">
                                <Text size="4" weight="bold">
                                    {client.name}
                                </Text>
                                <LinkButton
                                    url={`https://drive.google.com/drive/folders/${client.folderId}`}
                                />
                            </Flex>
                        </Flex>
                        <Box>
                            <ReleaseList
                                clientId={client.id}
                                clientName={client.name}
                                releases={releases}
                                server:defer
                            >
                                <LoadingSpinner
                                    text="Loading releases..."
                                    slot="fallback"
                                />
                            </ReleaseList>
                        </Box>
                    </Flex>
                </Card>
            </Box>
        </Grid>
    </Container>
</Layout>

<style>
    .back-button {
        /* position: absolute; */
        transform: translateY(-100%);
    }
</style>
