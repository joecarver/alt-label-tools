---
import Layout from "@/layouts/Layout.astro";
import { Card, Text, Flex, Button, Container } from "@radix-ui/themes";

import type { LabelClient } from "@/types/LabelClient";

const { id } = Astro.params;
const { clients, isAdmin } = Astro.locals;
const client = clients.find((c: LabelClient) => c.id === id);

if (!client) {
  return Astro.redirect("/");
}
---

<Layout title="New Release">
  <Container size="2">
    <Card size="2">
      <Flex direction="column" gap="4">
        <Flex justify="between" align="center">
          <Text size="6" weight="bold">New Release for {client.name}</Text>
          {
            isAdmin && (
              <Button id="fillTestData" variant="soft" size="2">
                Fill Test Data
              </Button>
            )
          }
        </Flex>

        <form id="releaseForm">
          <input
            type="hidden"
            id="client_id"
            name="client_id"
            value={client.id}
          />
          <input
            type="hidden"
            id="client_folder_id"
            name="client_folder_id"
            value={client.folderId}
          />
          <input
            type="hidden"
            id="client_name"
            name="client_name"
            value={client.name}
          />
          <Flex direction="column" gap="4">
            <Card size="2">
              <Flex direction="column" gap="3">
                <Text size="4" weight="bold">Artist Information</Text>

                <input
                  type="text"
                  id="artist_name"
                  name="artist_name"
                  placeholder="Artist Name"
                  required
                  style={{
                    width: "100%",
                    padding: "0.5rem",
                    borderRadius: "0.25rem",
                    border: "1px solid #ccc",
                  }}
                />

                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="Artist Email"
                  required
                  style={{
                    width: "100%",
                    padding: "0.5rem",
                    borderRadius: "0.25rem",
                    border: "1px solid #ccc",
                  }}
                />

                <input
                  type="text"
                  id="gov_name"
                  name="gov_name"
                  placeholder="Full Name"
                  required
                  style={{
                    width: "100%",
                    padding: "0.5rem",
                    borderRadius: "0.25rem",
                    border: "1px solid #ccc",
                  }}
                />

                <textarea
                  id="address"
                  name="address"
                  placeholder="Artist Address"
                  required
                  style={{
                    width: "100%",
                    padding: "0.5rem",
                    borderRadius: "0.25rem",
                    border: "1px solid #ccc",
                    minHeight: "100px",
                  }}></textarea>

                <input
                  type="url"
                  id="spotify_url"
                  name="spotify_url"
                  placeholder="Artist Spotify URL (e.g. https://open.spotify.com/artist/...)"
                  pattern="https://open\.spotify\.com/artist/[a-zA-Z0-9]+(\?si=[a-zA-Z0-9-]+)?"
                  style={{
                    width: "100%",
                    padding: "0.5rem",
                    borderRadius: "0.25rem",
                    border: "1px solid #ccc",
                  }}
                />

                <input
                  type="url"
                  id="bandcamp_url"
                  name="bandcamp_url"
                  placeholder="Artist Bandcamp URL (e.g. https://artist.bandcamp.com/)"
                  pattern="https://[a-zA-Z0-9-]+\.bandcamp\.com/?.*"
                  style={{
                    width: "100%",
                    padding: "0.5rem",
                    borderRadius: "0.25rem",
                    border: "1px solid #ccc",
                  }}
                />

                <input
                  type="url"
                  id="apple_music_url"
                  name="apple_music_url"
                  placeholder="Artist Apple Music URL (e.g. https://music.apple.com/...)"
                  pattern="https://music\.apple\.com/[a-z]{2}/artist/[^/]+/[0-9]+"
                  style={{
                    width: "100%",
                    padding: "0.5rem",
                    borderRadius: "0.25rem",
                    border: "1px solid #ccc",
                  }}
                />
              </Flex>
            </Card>

            <Card size="2">
              <Flex direction="column" gap="3">
                <Text size="4" weight="bold">Release Information</Text>

                <input
                  type="text"
                  id="catalog_number"
                  name="catalog_number"
                  placeholder="Catalog Number"
                  required
                  style={{
                    width: "100%",
                    padding: "0.5rem",
                    borderRadius: "0.25rem",
                    border: "1px solid #ccc",
                  }}
                />

                <input
                  type="text"
                  id="name"
                  name="name"
                  placeholder="Release Name"
                  required
                  style={{
                    width: "100%",
                    padding: "0.5rem",
                    borderRadius: "0.25rem",
                    border: "1px solid #ccc",
                  }}
                />

                <input
                  type="date"
                  id="release_date"
                  name="release_date"
                  required
                  style={{
                    width: "100%",
                    padding: "0.5rem",
                    borderRadius: "0.25rem",
                    border: "1px solid #ccc",
                  }}
                />

                <div>
                  <Text size="2">Campaign Length</Text>
                  <label
                    style={{
                      display: "inline-flex",
                      alignItems: "center",
                      marginRight: "1rem",
                    }}
                  >
                    <input
                      type="radio"
                      id="campaign_length_8"
                      name="campaign_length"
                      value="8"
                      required
                    />
                    <Text size="2" style={{ marginLeft: "0.5rem" }}
                      >8 Weeks</Text
                    >
                  </label>
                  <label
                    style={{ display: "inline-flex", alignItems: "center" }}
                  >
                    <input
                      type="radio"
                      id="campaign_length_12"
                      name="campaign_length"
                      value="12"
                      required
                    />
                    <Text size="2" style={{ marginLeft: "0.5rem" }}
                      >12 Weeks</Text
                    >
                  </label>
                </div>
              </Flex>
            </Card>

            <Card size="2">
              <Flex direction="column" gap="3">
                <Text size="4" weight="bold">Team Information</Text>

                <input
                  type="email"
                  id="mastering_engineer_email"
                  name="mastering_engineer_email"
                  placeholder="Mastering Engineer Email"
                  required
                  style={{
                    width: "100%",
                    padding: "0.5rem",
                    borderRadius: "0.25rem",
                    border: "1px solid #ccc",
                  }}
                />

                <input
                  type="email"
                  id="designer_email"
                  name="designer_email"
                  placeholder="Designer Email"
                  required
                  style={{
                    width: "100%",
                    padding: "0.5rem",
                    borderRadius: "0.25rem",
                    border: "1px solid #ccc",
                  }}
                />
              </Flex>
            </Card>

            <Card size="2">
              <Flex direction="column" gap="3">
                <Text size="4" weight="bold">Services Required</Text>

                <Flex direction="column" gap="2">
                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="service_mixing"
                      name="services_required"
                      value="Mixing"
                    />
                    <Text size="2">Mixing</Text>
                  </label>

                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="service_mastering"
                      name="services_required"
                      value="Mastering"
                    />
                    <Text size="2">Mastering</Text>
                  </label>

                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="service_press_release"
                      name="services_required"
                      value="Press Release Written"
                    />
                    <Text size="2">Press Release</Text>
                  </label>

                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="service_press"
                      name="services_required"
                      value="Press"
                    />
                    <Text size="2">Press</Text>
                  </label>

                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="service_dj_promo"
                      name="services_required"
                      value="DJ Promo"
                    />
                    <Text size="2">DJ Promo</Text>
                  </label>

                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="service_sync"
                      name="services_required"
                      value="Sync"
                    />
                    <Text size="2">Sync</Text>
                  </label>

                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="service_marketing"
                      name="services_required"
                      value="Marketing Driver"
                    />
                    <Text size="2">Marketing Driver</Text>
                  </label>

                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="service_playlist"
                      name="services_required"
                      value="Playlist Pitching"
                    />
                    <Text size="2">Playlist Pitching</Text>
                  </label>
                </Flex>
              </Flex>
            </Card>

            <Card size="2">
              <Flex direction="column" gap="3">
                <Text size="4" weight="bold">License Information</Text>

                <Flex direction="column" gap="2">
                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="license_allow_politics"
                      name="license_allow_politics"
                    />
                    <Text size="2">Allow Politics</Text>
                  </label>

                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="license_allow_alcohol"
                      name="license_allow_alcohol"
                    />
                    <Text size="2">Allow Alcohol</Text>
                  </label>

                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="license_allow_pharmaceuticals"
                      name="license_allow_pharmaceuticals"
                    />
                    <Text size="2">Allow Pharmaceuticals</Text>
                  </label>

                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="license_allow_fastfood"
                      name="license_allow_fastfood"
                    />
                    <Text size="2">Allow Fast Food</Text>
                  </label>

                  <label
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                    }}
                  >
                    <input
                      type="checkbox"
                      id="license_allow_fastfashion"
                      name="license_allow_fastfashion"
                    />
                    <Text size="2">Allow Fast Fashion</Text>
                  </label>
                </Flex>
              </Flex>
            </Card>

            <Button
              type="submit"
              size="3"
              style={{ width: "100%" }}
              color="blue"
            >
              Submit Release
            </Button>
          </Flex>
        </form>
      </Flex>
    </Card>
  </Container>
</Layout>

<style>
  button[type="submit"]:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<script>
  const form = document.getElementById("releaseForm") as HTMLFormElement;
  const fillTestDataButton = document.getElementById(
    "fillTestData"
  ) as HTMLButtonElement;
  const submitButton = form.querySelector(
    "button[type='submit']"
  ) as HTMLButtonElement;

  const testData = {
    artist_name: "Test Artist",
    email: "test@example.com",
    gov_name: "Test Artist Full Name",
    address: "123 Test Street\nTest City, TS 12345",
    spotify_url:
      "https://open.spotify.com/artist/6gnPiTUdUPttmm5N8j7Rvy?si=JxMY6XhgSSy8rv-6XYclPA",
    bandcamp_url: "https://djpitch.bandcamp.com/",
    apple_music_url: "https://music.apple.com/gb/artist/dj-pitch/1468564384",
    catalog_number: "ALT001",
    name: "Test Release",
    release_date: new Date().toISOString().split("T")[0],
    campaign_length: "8",
    mastering_engineer_email: "mastering@example.com",
    designer_email: "designer@example.com",
    license_allow_politics: true,
    license_allow_alcohol: true,
    license_allow_pharmaceuticals: false,
    license_allow_fastfood: false,
    license_allow_fastfashion: false,
    services_required: ["Mixing", "Mastering", "Press Release Written"],
  };

  fillTestDataButton.addEventListener("click", () => {
    // Fill text inputs
    Object.entries(testData).forEach(([key, value]) => {
      if (key === "campaign_length") {
        const radio = form.querySelector(
          `input[name="campaign_length"][value="${value}"]`
        ) as HTMLInputElement;
        if (radio) radio.checked = true;
        return;
      }
      const element = form.elements.namedItem(key) as HTMLInputElement;
      if (element) {
        if (element.type === "checkbox") {
          element.checked = value as boolean;
        } else if (element.type === "date") {
          element.value = value as string;
        } else if (element.type === "number") {
          element.value = value as string;
        } else if (element.tagName === "TEXTAREA") {
          element.value = value as string;
        } else {
          element.value = value as string;
        }
      }
    });

    // Handle services checkboxes
    const serviceCheckboxes = form.querySelectorAll(
      'input[name="services_required"]'
    );
    serviceCheckboxes.forEach((checkbox) => {
      const input = checkbox as HTMLInputElement;
      input.checked = testData.services_required.includes(input.value);
    });
  });

  form.addEventListener("submit", async (e) => {
    submitButton.disabled = true;
    e.preventDefault();

    const formData = new FormData(form);
    const data = {
      artist_name: formData.get("artist_name"),
      email: formData.get("email"),
      gov_name: formData.get("gov_name"),
      address: formData.get("address"),
      spotify_url: formData.get("spotify_url"),
      bandcamp_url: formData.get("bandcamp_url"),
      apple_music_url: formData.get("apple_music_url"),
      catalog_number: formData.get("catalog_number"),
      name: formData.get("name"),
      release_date: formData.get("release_date"),
      campaign_length: formData.get("campaign_length"),
      mastering_engineer_email: formData.get("mastering_engineer_email"),
      designer_email: formData.get("designer_email"),
      license_allow_politics: formData.get("license_allow_politics") === "on",
      license_allow_alcohol: formData.get("license_allow_alcohol") === "on",
      license_allow_pharmaceuticals:
        formData.get("license_allow_pharmaceuticals") === "on",
      license_allow_fastfood: formData.get("license_allow_fastfood") === "on",
      license_allow_fastfashion:
        formData.get("license_allow_fastfashion") === "on",
      services_required: Array.from(formData.getAll("services_required")).join(
        ";"
      ),
      client_id: formData.get("client_id"),
      client_folder_id: formData.get("client_folder_id"),
      client_name: formData.get("client_name"),
    };

    try {
      const response = await fetch("/api/create-release", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error);
      }

      alert("Release submitted successfully!");
      window.location.href = `/client/${data.client_id}`;
    } catch (error: any) {
      submitButton.disabled = false;
      console.error(error.message);
      if (error.message.includes("releases_client_id_catalog_number_key")) {
        alert(
          "Catalog number already exists. Please use a different catalog number."
        );
      } else {
        alert("Failed to submit release. Please try again.");
      }
    }
  });
</script>
