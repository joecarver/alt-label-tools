---
import Layout from "@/layouts/Layout.astro";
import type { LabelClient } from "@/types/LabelClient";
import { NewReleaseForm } from "@/components/NewReleaseForm";

const { id } = Astro.params;
const { clients, isAdmin } = Astro.locals;
const client = clients.find((c: LabelClient) => c.id === id);

if (!client) {
  return Astro.redirect("/");
}
---

<Layout title="New Release">
  <NewReleaseForm client={client} isAdmin={isAdmin} client:load />
</Layout>
