---
import Layout from '../../layouts/Layout.astro';
import { Card, Text, Flex, Button, Container, Theme } from "@radix-ui/themes";
import "@radix-ui/themes/styles.css";
import { getClients } from "../../utils/supabase";
import type { LabelClient } from "../../types/LabelClient";
import { getAuthTokenFromCookies, getUserFromToken } from "../../utils/auth";
import { isAdmin } from "../../utils/authorization";

const clientId = Astro.url.searchParams.get('clientId');
const token = getAuthTokenFromCookies(Astro.cookies);
if (!token) {
	return Astro.redirect("/login");
}

let user;
try {
	user = await getUserFromToken(token);
	if (!user) {
		return Astro.redirect("/login");
	}
} catch (error) {
	console.error("Token verification failed:", error);
	return Astro.redirect("/login");
}

const clients = await getClients(user.email && isAdmin(user.email) ? undefined : user.id);
const client = clients.find((c: LabelClient) => c.id === clientId);

if (!client) {
  return Astro.redirect('/');
}
---

<Layout title="New Release">
  <Theme>
    <Container size="2">
      <Card size="2">
        <Flex direction="column" gap="4">
          <Flex justify="between" align="center">
            <Text size="6" weight="bold">New Release for {client.name}</Text>
            <Button id="fillTestData" variant="soft" size="2">Fill Test Data</Button>
          </Flex>
          
          <form id="releaseForm">
            <input type="hidden" id="client_id" name="client_id" value={client.id} />
            <Flex direction="column" gap="4">
              <Card size="2">
                <Flex direction="column" gap="3">
                  <Text size="4" weight="bold">Artist Information</Text>
                  
                  <input type="text" id="artist_name" name="artist_name" placeholder="Artist Name" required 
                    style={{ width: '100%', padding: '0.5rem', borderRadius: '0.25rem', border: '1px solid #ccc' }} />

                  <input type="email" id="email" name="email" placeholder="Artist Email" required 
                    style={{ width: '100%', padding: '0.5rem', borderRadius: '0.25rem', border: '1px solid #ccc' }} />

                  <input type="text" id="gov_name" name="gov_name" placeholder="Full Name" required 
                    style={{ width: '100%', padding: '0.5rem', borderRadius: '0.25rem', border: '1px solid #ccc' }} />

                  <textarea id="address" name="address" placeholder="Artist Address" required 
                    style={{ width: '100%', padding: '0.5rem', borderRadius: '0.25rem', border: '1px solid #ccc', minHeight: '100px' }}></textarea>
                </Flex>
              </Card>

              <Card size="2">
                <Flex direction="column" gap="3">
                  <Text size="4" weight="bold">Release Information</Text>
                  
                  <input type="text" id="catalog_number" name="catalog_number" placeholder="Release Number" required 
                    style={{ width: '100%', padding: '0.5rem', borderRadius: '0.25rem', border: '1px solid #ccc' }} />

                  <input type="text" id="name" name="name" placeholder="Release Name" required 
                    style={{ width: '100%', padding: '0.5rem', borderRadius: '0.25rem', border: '1px solid #ccc' }} />

                  <input type="date" id="release_date" name="release_date" required 
                    style={{ width: '100%', padding: '0.5rem', borderRadius: '0.25rem', border: '1px solid #ccc' }} />

                  <div>
                    <Text size="2">Campaign Length</Text>
                    <label style={{ display: 'inline-flex', alignItems: 'center', marginRight: '1rem' }}>
                      <input type="radio" id="campaign_length_8" name="campaign_length" value="8" required />
                      <Text size="2" style={{ marginLeft: '0.5rem' }}>8 Weeks</Text>
                    </label>
                    <label style={{ display: 'inline-flex', alignItems: 'center' }}>
                      <input type="radio" id="campaign_length_12" name="campaign_length" value="12" required />
                      <Text size="2" style={{ marginLeft: '0.5rem' }}>12 Weeks</Text>
                    </label>
                  </div>
                </Flex>
              </Card>

              <Card size="2">
                <Flex direction="column" gap="3">
                  <Text size="4" weight="bold">Team Information</Text>
                  
                  <input type="email" id="mastering_engineer_email" name="mastering_engineer_email" placeholder="Mastering Engineer Email" required 
                    style={{ width: '100%', padding: '0.5rem', borderRadius: '0.25rem', border: '1px solid #ccc' }} />

                  <input type="email" id="designer_email" name="designer_email" placeholder="Designer Email" required 
                    style={{ width: '100%', padding: '0.5rem', borderRadius: '0.25rem', border: '1px solid #ccc' }} />
                </Flex>
              </Card>

              <Card size="2">
                <Flex direction="column" gap="3">
                  <Text size="4" weight="bold">License Information</Text>
                  
                  <Flex direction="column" gap="2">
                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="license_allow_politics" name="license_allow_politics" />
                      <Text size="2">Allow Politics</Text>
                    </label>

                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="license_allow_alcohol" name="license_allow_alcohol" />
                      <Text size="2">Allow Alcohol</Text>
                    </label>

                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="license_allow_pharmaceuticals" name="license_allow_pharmaceuticals" />
                      <Text size="2">Allow Pharmaceuticals</Text>
                    </label>

                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="license_allow_fastfood" name="license_allow_fastfood" />
                      <Text size="2">Allow Fast Food</Text>
                    </label>

                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="license_allow_fastfashion" name="license_allow_fastfashion" />
                      <Text size="2">Allow Fast Fashion</Text>
                    </label>
                  </Flex>
                </Flex>
              </Card>

              <Card size="2">
                <Flex direction="column" gap="3">
                  <Text size="4" weight="bold">Services Required</Text>
                  
                  <Flex direction="column" gap="2">
                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="service_mixing" name="services_required" value="Mixing" />
                      <Text size="2">Mixing</Text>
                    </label>

                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="service_mastering" name="services_required" value="Mastering" />
                      <Text size="2">Mastering</Text>
                    </label>

                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="service_press_release" name="services_required" value="Press Release Written" />
                      <Text size="2">Press Release</Text>
                    </label>

                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="service_press" name="services_required" value="Press" />
                      <Text size="2">Press</Text>
                    </label>

                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="service_dj_promo" name="services_required" value="DJ Promo" />
                      <Text size="2">DJ Promo</Text>
                    </label>

                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="service_sync" name="services_required" value="Sync" />
                      <Text size="2">Sync</Text>
                    </label>

                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="service_marketing" name="services_required" value="Marketing Driver" />
                      <Text size="2">Marketing Driver</Text>
                    </label>

                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                      <input type="checkbox" id="service_playlist" name="services_required" value="Playlist Pitching" />
                      <Text size="2">Playlist Pitching</Text>
                    </label>
                  </Flex>
                </Flex>
              </Card>

              <Button type="submit" size="3" style={{ width: '100%' }}>
                Submit Release
              </Button>
            </Flex>
          </form>
        </Flex>
      </Card>
    </Container>
  </Theme>
</Layout>

<script>
  const form = document.getElementById('releaseForm') as HTMLFormElement;
  const fillTestDataButton = document.getElementById('fillTestData') as HTMLButtonElement;

  const testData = {
    artist_name: 'Test Artist',
    email: 'test@example.com',
    gov_name: 'Test Artist Full Name',
    address: '123 Test Street\nTest City, TS 12345',
    catalog_number: 'ALT001',
    name: 'Test Release',
    release_date: new Date().toISOString().split('T')[0],
    campaign_length: '8',
    mastering_engineer_email: 'mastering@example.com',
    designer_email: 'designer@example.com',
    license_allow_politics: true,
    license_allow_alcohol: true,
    license_allow_pharmaceuticals: false,
    license_allow_fastfood: false,
    license_allow_fastfashion: false,
    services_required: ['Mixing', 'Mastering', 'Press Release Written']
  };

  fillTestDataButton.addEventListener('click', () => {
    // Fill text inputs
    Object.entries(testData).forEach(([key, value]) => {
      if (key === 'campaign_length') {
        const radio = form.querySelector(`input[name="campaign_length"][value="${value}"]`) as HTMLInputElement;
        if (radio) radio.checked = true;
        return;
      }
      const element = form.elements.namedItem(key) as HTMLInputElement;
      if (element) {
        if (element.type === 'checkbox') {
          element.checked = value as boolean;
        } else if (element.type === 'date') {
          element.value = value as string;
        } else if (element.type === 'number') {
          element.value = value as string;
        } else if (element.tagName === 'TEXTAREA') {
          element.value = value as string;
        } else {
          element.value = value as string;
        }
      }
    });

    // Handle services checkboxes
    const serviceCheckboxes = form.querySelectorAll('input[name="services_required"]');
    serviceCheckboxes.forEach((checkbox) => {
      const input = checkbox as HTMLInputElement;
      input.checked = testData.services_required.includes(input.value);
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = {
      artist_name: formData.get('artist_name'),
      email: formData.get('email'),
      gov_name: formData.get('gov_name'),
      address: formData.get('address'),
      catalog_number: formData.get('catalog_number'),
      name: formData.get('name'),
      release_date: formData.get('release_date'),
      campaign_length: formData.get('campaign_length'),
      mastering_engineer_email: formData.get('mastering_engineer_email'),
      designer_email: formData.get('designer_email'),
      license_allow_politics: formData.get('license_allow_politics') === 'on',
      license_allow_alcohol: formData.get('license_allow_alcohol') === 'on',
      license_allow_pharmaceuticals: formData.get('license_allow_pharmaceuticals') === 'on',
      license_allow_fastfood: formData.get('license_allow_fastfood') === 'on',
      license_allow_fastfashion: formData.get('license_allow_fastfashion') === 'on',
      services_required: Array.from(formData.getAll('services_required')).join(';'),
      client_id: formData.get('client_id'),
    };

    try {
      const response = await fetch('/api/create-release', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      if (!response.ok) {
        throw new Error('Failed to submit release');
      }

      const result = await response.json();
      alert('Release submitted successfully!');
      window.location.href = `/client/${data.client_id}`;
    } catch (error) {
      console.error('Error submitting release:', error);
      alert('Failed to submit release. Please try again.');
    }
  });
</script> 