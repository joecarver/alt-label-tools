---
import { Box, Button, Flex, Heading, Text, Theme } from "@radix-ui/themes";
import "@radix-ui/themes/styles.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - Alt Label Tools</title>
  </head>
  <body>
    <Theme
      appearance="dark"
      accentColor="yellow"
      grayColor="slate"
      scaling="100%"
    >
      <Box className="login-container">
        <Flex direction="column" gap="4" className="login-card">
          <Heading as="h1" size="9"> ALT </Heading>
          <Heading as="h2" size="4"> Automated Label Tools </Heading>

          <div id="otpExpiredError" style="display:none;">
            <span style="color: #ef4444; margin-bottom: 1rem; display: block;"
              >Your reset link has expired. Please request a new email below.</span
            >
            <form id="requestResetForm" style="width: 100%;">
              <Flex direction="column" gap="3">
                <input
                  type="email"
                  id="resetEmail"
                  name="resetEmail"
                  placeholder="Enter your email"
                  required
                />
                <Button
                  type="submit"
                  color="yellow"
                  size="3"
                  id="resetButton"
                  className="login-button"
                >
                  Request new email
                </Button>
                <span
                  id="resetMessage"
                  class="login-message hidden"
                  style="color: #22c55e;"></span>
                <span
                  id="resetError"
                  class="login-error hidden"
                  style="color: #ef4444;"></span>
              </Flex>
            </form>
          </div>

          <form id="passwordForm" style="width: 100%;">
            <Flex direction="column" gap="3">
              <input
                type="password"
                id="password"
                name="password"
                placeholder="New Password"
                required
              />
              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                placeholder="Confirm Password"
                required
              />
              <Button
                type="submit"
                color="blue"
                size="4"
                className="login-button"
                id="passwordButton"
              >
                Set Password
                <Text id="passwordError" color="red" className="login-error" />
              </Button>
            </Flex>
          </form>
        </Flex>
      </Box>
      <script type="module">
        function getParams() {
          const searchParams = new URLSearchParams(window.location.search);
          if (window.location.hash && window.location.hash.startsWith("#")) {
            const hashParams = new URLSearchParams(
              window.location.hash.slice(1)
            );
            for (const [key, value] of hashParams.entries()) {
              searchParams.set(key, value);
            }
          }
          return searchParams;
        }
        const urlParams = getParams();
        const errorCode = urlParams.get("error_code");
        const otpExpiredError = document.getElementById("otpExpiredError");
        const passwordForm = document.getElementById("passwordForm");
        if (errorCode === "otp_expired") {
          otpExpiredError.style.display = "block";
          passwordForm.style.display = "none";
        }
        // Password reset request form logic
        const requestResetForm = document.getElementById("requestResetForm");
        if (requestResetForm) {
          const resetButton = document.getElementById("resetButton");
          const resetEmail = document.getElementById("resetEmail");
          const resetMessage = document.getElementById("resetMessage");
          const resetError = document.getElementById("resetError");
          requestResetForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            resetMessage.classList.add("hidden");
            resetError.classList.add("hidden");
            resetButton.classList.add("disabled");
            try {
              const response = await fetch("/api/request-password-reset", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email: resetEmail.value }),
              });
              const result = await response.json();
              if (!response.ok) {
                resetError.textContent =
                  result.error || "Failed to send reset email.";
                resetError.classList.remove("hidden");
                return;
              }
              resetMessage.textContent = "Password reset email sent!";
              resetMessage.classList.remove("hidden");
            } catch (err) {
              resetError.textContent = "An error occurred. Please try again.";
              resetError.classList.remove("hidden");
            } finally {
              resetButton.classList.remove("disabled");
            }
          });
        }

        const form = document.getElementById("passwordForm");
        const errorText = document.getElementById("passwordError");
        const submitButton = document.getElementById("passwordButton");
        const token = urlParams.get("access_token");
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          errorText.style.display = "none";
          const password = form.password.value;
          const confirmPassword = form.confirmPassword.value;
          if (password !== confirmPassword) {
            errorText.textContent = "Passwords do not match.";
            errorText.style.display = "block";
            return;
          }
          submitButton.classList.add("disabled");
          try {
            const response = await fetch("/api/update-password", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ password, token }),
            });
            if (!response.ok) {
              const result = await response.json();
              errorText.textContent = result.error || "Password update failed.";
              errorText.style.display = "block";
              return;
            }
            alert(
              "Password updated successfully. Please login with your new password."
            );
            window.location.href = "/login";
          } catch (err) {
            errorText.textContent = "An error occurred. Please try again.";
            errorText.style.display = "block";
          } finally {
            submitButton.classList.remove("disabled");
          }
        });
      </script>
    </Theme>

    <style>
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: #f9fafb;
      }

      .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .login-card {
        max-width: 28rem;
        width: 100%;
        padding: 2rem;
        background-color: var(--gray-5);
        border-radius: 0.5rem;
      }

      input {
        width: 100%;
        padding: 0.5rem;
        box-sizing: border-box;
        font-size: 1rem;
      }

      .login-button {
        width: 100%;
        font-size: 1rem;

        &.disabled {
          opacity: 0.5;
          cursor: not-allowed;
        }
      }

      .login-error {
        display: none;
      }

      .login-message {
        margin-top: 0.5rem;
      }
      .hidden {
        display: none;
      }
      .visible {
        display: block;
      }
    </style>
  </body>
</html>
