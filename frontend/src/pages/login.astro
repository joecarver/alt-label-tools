---
import { getAuthTokenFromCookies } from "../utils/auth";
import { Box, Button, Flex, Heading, Text, Theme } from "@radix-ui/themes";
import "@radix-ui/themes/styles.css";

// Check if user is already authenticated
const token = getAuthTokenFromCookies(Astro.cookies);
if (token) {
  return Astro.redirect("/");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Alt Label Tools</title>
  </head>
  <body>
    <Theme
      appearance="dark"
      accentColor="yellow"
      grayColor="slate"
      scaling="100%"
    >
      <Box className="login-container">
        <Flex direction="column" gap="4" className="login-card">
          <Heading as="h1" size="9"> ALT </Heading>
          <Heading as="h2" size="4"> Automated Label Tools </Heading>

          <form id="loginForm" style="width: 100%;">
            <Flex direction="column" gap="3">
              <input
                type="email"
                id="email"
                name="email"
                placeholder="Email"
                required
              />
              <input
                type="password"
                id="password"
                name="password"
                placeholder="Password"
                required
              />
              <Button
                type="submit"
                color="blue"
                size="4"
                className="login-button"
                id="loginButton"
              >
                Sign in
                <Text id="loginError" color="red" className="login-error" />
              </Button>
            </Flex>
          </form>
        </Flex>
      </Box>
      <script type="module">
        const form = document.getElementById("loginForm");
        const errorText = document.getElementById("loginError");
        const submitButton = document.getElementById("loginButton");

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          errorText.style.display = "none";
          const email = form.email.value;
          const password = form.password.value;
          submitButton.classList.add("disabled");
          try {
            const response = await fetch("/api/auth", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email, password, type: "login" }),
            });
            if (!response.ok) {
              const result = await response.json();
              errorText.textContent = result.error || "Login failed.";
              errorText.style.display = "block";
              return;
            }
            window.location.href = "/";
          } catch (err) {
            errorText.textContent = "An error occurred. Please try again.";
            errorText.style.display = "block";
          } finally {
            submitButton.classList.remove("disabled");
          }
        });
      </script>
    </Theme>

    <style>
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: #f9fafb;
      }

      .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .login-card {
        max-width: 28rem;
        width: 100%;
        padding: 2rem;
        background-color: var(--gray-5);
        border-radius: 0.5rem;
      }

      input {
        width: 100%;
        padding: 0.5rem;
        box-sizing: border-box;
        font-size: 1rem;
      }

      .login-button {
        width: 100%;
        font-size: 1rem;

        &.disabled {
          opacity: 0.5;
          cursor: not-allowed;
        }
      }

      .login-error {
        display: none;
      }
    </style>
  </body>
</html>
