---
import { Badge } from "@radix-ui/themes";
import { CheckIcon } from "@radix-ui/react-icons";
import { formatSingleDate } from "../utils/date";
import { TaskCompletionButton } from "./TaskCompletionButton";
import { CompletionStatus } from "src/types/CompletionStatus";

const { task, isDetectable, taskStatus, releaseId } = Astro.props;
---

{
    isDetectable ? (
        taskStatus?.fileInfo?.createdTime && (
            <Badge size="2" color="green" variant="soft">
                <CheckIcon />
                Completed: {formatSingleDate(taskStatus.fileInfo.createdTime)}
            </Badge>
        )
    ) : (
        <TaskCompletionButton
            client:load
            taskId={task.id}
            releaseId={releaseId}
            completedAt={taskStatus?.completionStatus === CompletionStatus.DONE_MANUALLY ? task.completedAt : undefined}
        />
    )
}
