---
import { Badge, Card, Flex, Text } from "@radix-ui/themes";
import { DriveLinkButton } from "./DriveLinkButton";
import type { LabelClient } from "@/types/LabelClient";
import { isAfter, isBefore } from "date-fns";

interface Props {
  client: LabelClient;
}

const { client } = Astro.props;

const completedReleases = client.releases.filter((release) =>
  isBefore(new Date(release.releaseDate || ""), new Date())
);

const upcomingReleases = client.releases.filter((release) =>
  isAfter(new Date(release.releaseDate || ""), new Date())
);
---

<a href={`/client/${client.id}`}>
  <Card key={client.id} size="2">
    <Flex direction="column" justify="between">
      <Flex align="center" justify="between" gap="2" width="100%">
        <Text size="4" weight="bold">
          {client.name}
        </Text>
      </Flex>
      <Flex align="center" gap="2">
        <Badge size="1" variant="outline" style={{ opacity: "0.8" }}>
          {completedReleases.length} release{
            completedReleases.length === 1 ? "" : "s"
          }
          completed
        </Badge>
        <Badge size="1" variant="outline" style={{ opacity: "0.8" }}>
          {upcomingReleases.length} release{
            upcomingReleases.length === 1 ? "" : "s"
          }
          upcoming
        </Badge>
      </Flex>
    </Flex>
  </Card>
</a>

<style>
  a {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
</style>
