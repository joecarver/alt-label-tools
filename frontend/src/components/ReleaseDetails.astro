---
import { Card, Text, Flex, Badge, Spinner, Box } from "@radix-ui/themes";
import TaskList from "./TaskList.astro";
import type { Release } from "@/types/Release";

import { formatSingleDate } from "../utils/date";
import { DriveLinkButton } from "./DriveLinkButton";
import { ReleaseTaskName } from "@/types/ReleaseTask";
import { getTasks } from "@/utils/supabase";
import { DownloadButton } from "./DownloadButton";

interface Props {
  release: Release;
}

const { release } = Astro.props;
const { isAdmin } = Astro.locals;

const folderUrl = `https://drive.google.com/drive/folders/${release.folderId}`;

const taskFolderIds: Record<string, string> = {
  [ReleaseTaskName.PreMastersSubmitted]: release.premastersFolderId || "",
  [ReleaseTaskName.MastersSubmitted]: release.mastersFolderId || "",
  [ReleaseTaskName.ArtworkCreation]: release.artworkFolderId || "",
  [ReleaseTaskName.ContractCreated]: release.documentationFolderId || "",
};

const userReleasePermissions = release.userReleasePermissions
  ? release.userReleasePermissions.map((permission) => permission.role)
  : undefined;

const tasks = await getTasks(release.id, userReleasePermissions);

const masteringDueDate = tasks.find(
  (task) => task.name === ReleaseTaskName.MastersSubmitted
)?.startDate;

const designerDueDate = tasks.find(
  (task) => task.name === ReleaseTaskName.ArtworkCreation
)?.startDate;
---

<Card size="2">
  <Flex direction="column" gap="3">
    <Flex justify="between" align="center">
      <Flex direction="column" gap="1" width="100%">
        <Flex justify="between" width="100%">
          <Flex align="baseline" gap="2">
            <Text size="4" weight="bold">
              {release.name}
            </Text>
            <Text size="2" color="gray">{release.catalogNumber}</Text>
          </Flex>
          {
            isAdmin ? (
              <DriveLinkButton url={folderUrl} />
            ) : (
              <DownloadButton
                text="Download Pre-Masters"
                fileName={`${release.artists.map((artist) => artist.artistName).join(", ")} - ${release.name} (${release.catalogNumber}) [Premasters].zip`}
                folderId={release.premastersFolderId ?? ""}
                client:load
              />
            )
          }
        </Flex>
        <Text size="3">
          {release.artists.map((artist) => artist.artistName).join(", ")}
        </Text>
      </Flex>
    </Flex>
    <Box>
      <Badge size="2" color="blue" variant="soft">
        Release Date: {
          release.releaseDate ? formatSingleDate(release.releaseDate) : "TBD"
        }
      </Badge>
    </Box>
    <TaskList
      releaseId={release.id}
      tasks={tasks}
      taskFolderIds={taskFolderIds}
      releaseName={release.name}
      catalogNumber={release.catalogNumber ?? ""}
      releaseDate={release.releaseDate ?? ""}
      labelName={release.client.name}
      artists={release.artists}
      tasksData={tasks}
      premastersEmailsSent={release.premasterEmailsSent ?? false}
      documentationFolderId={release.documentationFolderId ?? ""}
      licenseAllowPolitics={release.licenseAllowPolitics ?? false}
      licenseAllowAlcohol={release.licenseAllowAlcohol ?? false}
      licenseAllowPharmaceuticals={release.licenseAllowPharmaceuticals ?? false}
      licenseAllowFastFood={release.licenseAllowFastfood ?? false}
      licenseAllowFastFashion={release.licenseAllowFastfashion ?? false}
      masteringDueDate={masteringDueDate ?? ""}
      masteringEngineerEmail={release.masteringEngineer?.email ?? ""}
      designerEmail={release.designer?.email ?? ""}
      designerDueDate={designerDueDate ?? ""}
      server:defer
    >
      <Badge
        color="gray"
        variant="soft"
        size="2"
        style={{ width: "fit-content" }}
        slot="fallback"
      >
        <Spinner size="1" />
        Loading tasks...
      </Badge>
    </TaskList>
  </Flex>
</Card>
