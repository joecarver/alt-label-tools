---
import { Flex, Box } from "@radix-ui/themes";
import { getTasks } from "../utils/supabase";
import { TaskSummary } from "./TaskSummary";
import TaskItem from "./TaskItem.astro";

interface Props {
    releaseId: string;
}

const { releaseId } = Astro.props;

const tasks = await getTasks(releaseId);
---

<details>
    <summary>
        <TaskSummary
            client:load
            releaseId={releaseId}
            initialTasks={tasks}
        />
    </summary>

    <Box
        style={{ padding: "0.5rem 1rem", backgroundColor: "var(--gray-2)" }}
        className="task-list"
    >
        <Flex direction="column" gap="4">
            {
                tasks
                    .sort(
                        (a, b) =>
                            new Date(a.startDate).getTime() -
                            new Date(b.startDate).getTime(),
                    )
                    .map((task) => (
                        <TaskItem
                            task={task}
                            releaseId={releaseId}
                        />
        ))
    }
</Flex>

<style>
    summary {
        list-style: none;
    }
</style>
