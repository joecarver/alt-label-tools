---
import { Heading, Text } from "@radix-ui/themes";
import { getAuthTokenFromCookies } from "../utils/auth";
import { verifyToken } from "../utils/auth";
import Avatar from "./Avatar.astro";

// Get user info
const token = getAuthTokenFromCookies(Astro.cookies);
let userInfo = null;
if (token) {
    userInfo = await verifyToken(token);
}
---

<header>
    <Heading as="h1" className="header-title">ALT ~ Automated Label Tools</Heading>
    {userInfo && <Avatar userInfo={userInfo} />}
</header>

<style>
    header {
        height: var(--header-height);
        box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
        padding: 0.5rem 1rem;
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }


    .header-title {
        font-size: clamp(1rem, 2.5vw, 1.5rem);
        font-weight: 600;
        margin: 0;
    }
</style>
